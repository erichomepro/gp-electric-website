---
import BaseLayout from './BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

interface Props {
  title: string;
  description: string;
  headline: string;
  subheadline: string;
  heroDescription: string;
  services: Array<{ name: string; description: string }>;
  faqs: Array<{ question: string; answer: string }>;
  relatedServices?: Array<{ name: string; href: string }>;
}

const {
  title,
  description,
  headline,
  subheadline,
  heroDescription,
  services,
  faqs,
  relatedServices = []
} = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>
  <!-- Hero -->
  <section class="relative overflow-hidden py-16 sm:py-24" style="background: #0a0f1a;">
    <div class="absolute inset-0">
      <img src="/images/electrician-work.jpg" alt="GP Electric Inc electrician performing electrical work in Grande Prairie" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,15,26,0.80) 0%, rgba(13,21,38,0.75) 50%, rgba(10,22,40,0.85) 100%);"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-brand-blue font-semibold text-sm uppercase tracking-wider mb-3">{subheadline}</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-white leading-tight mb-6">
          {headline}
        </h1>
        <p class="text-lg text-brand-gray-300 mb-8 leading-relaxed">
          {heroDescription}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-brand-blue hover:bg-brand-blue-dark text-brand-white px-6 py-3.5 rounded-lg font-bold transition-colors">
            Get a Free Quote
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="tel:7808823046" class="inline-flex items-center justify-center gap-2 border-2 border-brand-gray-600 hover:border-brand-blue text-brand-white px-6 py-3.5 rounded-lg font-bold transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            780-882-3046
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content from page -->
  <slot name="content" />

  <!-- Services List -->
  <section class="py-16 bg-brand-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-gray-900 mb-10">What We Offer</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {services.map((service) => (
          <div class="flex gap-4 p-6 rounded-xl border border-brand-gray-200 hover:border-brand-blue/30 hover:shadow-sm transition-all">
            <div class="w-10 h-10 bg-brand-blue/10 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-brand-gray-900 mb-1">{service.name}</h3>
              <p class="text-sm text-brand-gray-500">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-brand-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-gray-900 mb-10 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-brand-white rounded-xl border border-brand-gray-200 overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-brand-gray-900 hover:text-brand-blue transition-colors">
              {faq.question}
              <svg class="w-5 h-5 text-brand-gray-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-brand-gray-600 leading-relaxed -mt-2">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Services -->
  {relatedServices.length > 0 && (
    <section class="py-12 bg-brand-white border-t border-brand-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h3 class="text-lg font-bold text-brand-gray-900 mb-6">Related Services</h3>
        <div class="flex flex-wrap gap-3">
          {relatedServices.map((rs) => (
            <a href={rs.href} class="px-4 py-2 rounded-lg border border-brand-gray-200 text-sm font-medium text-brand-gray-700 hover:border-brand-blue hover:text-brand-blue transition-colors">
              {rs.name}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <CTASection headline={`Need ${title}?`} subtext="Contact GP Electric today for a free, no-obligation quote. We'll get back to you fast." />
</BaseLayout>
