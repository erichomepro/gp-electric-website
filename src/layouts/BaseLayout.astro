---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  schema?: object;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  schema
} = Astro.props;

const siteUrl = 'https://www.gpelectricinc.com';
const fullTitle = title === 'Home'
  ? 'GP Electric Inc | Licensed Electrician in Grande Prairie, Alberta'
  : `${title} | GP Electric Inc. Grande Prairie Electrician`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="en_CA" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- Geo -->
  <meta name="geo.region" content="CA-AB" />
  <meta name="geo.placename" content="Grande Prairie" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Schema.org JSON-LD -->
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <!-- Default LocalBusiness Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Electrician",
    "name": "GP Electric Inc",
    "alternateName": "Grande Prairie Electric Inc",
    "url": siteUrl,
    "telephone": "+1-780-882-3046",
    "email": "gpelectric@outlook.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Grande Prairie",
      "addressRegion": "AB",
      "addressCountry": "CA"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "55.1707",
      "longitude": "-118.7947"
    },
    "foundingDate": "2013",
    "sameAs": [
      "https://www.facebook.com/gpelectricinc",
      "https://www.instagram.com/gpelectricinc"
    ],
    "areaServed": [
      { "@type": "City", "name": "Grande Prairie" },
      { "@type": "City", "name": "Clairmont" },
      { "@type": "City", "name": "Sexsmith" },
      { "@type": "City", "name": "Beaverlodge" },
      { "@type": "City", "name": "Wembley" },
      { "@type": "City", "name": "Hythe" },
      { "@type": "City", "name": "Spirit River" },
      { "@type": "City", "name": "Valleyview" },
      { "@type": "City", "name": "Fairview" },
      { "@type": "City", "name": "Peace River" }
    ],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "priceRange": "$$",
    "description": "Licensed electrician serving Grande Prairie and the Peace Country region. Residential, commercial, industrial, and farm electrical services. 24/7 emergency response.",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Electrical Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Residential Electrical" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Commercial Electrical" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Industrial Electrical" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Farm & Acreage Electrical" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "24/7 Emergency Electrical" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Panel Upgrades" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "EV Charger Installation" }},
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Generator Installation" }}
      ]
    }
  })} />
</head>
<body class="font-body text-brand-gray-800 bg-brand-white antialiased">
  <EmergencyBanner />
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <StickyMobileCTA />
</body>
</html>
