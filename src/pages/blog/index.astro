---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const description = "Electrical tips, guides, and news from GP Electric Inc in Grande Prairie. Learn about panel upgrades, electrical safety, EV chargers, and more.";

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout title="Blog" description={description}>
  <section class="relative overflow-hidden py-16 sm:py-24" style="background: #0a0f1a;">
    <div class="absolute inset-0">
      <img src="/images/electrician-work.jpg" alt="Electrician blog and tips from GP Electric Inc in Grande Prairie" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,15,26,0.80) 0%, rgba(13,21,38,0.75) 100%);"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-brand-blue font-semibold text-sm uppercase tracking-wider mb-3">GP Electric Blog</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-white leading-tight mb-6">
          Electrical Tips & Guides for Grande Prairie
        </h1>
        <p class="text-lg text-brand-gray-300 leading-relaxed">
          Helpful guides, safety tips, and electrical knowledge from your local Grande Prairie electrician. Stay informed, stay safe.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('en-CA', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <article class="bg-brand-white border border-brand-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition-shadow group">
              <div class="p-6 sm:p-8">
                <p class="text-sm text-brand-blue font-semibold uppercase tracking-wider mb-3">{formattedDate}</p>
                <h2 class="text-xl font-bold text-brand-gray-900 mb-3 group-hover:text-brand-blue transition-colors leading-snug">
                  <a href={`/blog/${post.id}`} class="block">
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-brand-gray-600 leading-relaxed mb-4 line-clamp-3">
                  {post.data.description}
                </p>
                <div class="flex items-center justify-between">
                  <p class="text-xs text-brand-gray-500">By {post.data.author}</p>
                  <a href={`/blog/${post.id}`} class="inline-flex items-center gap-1 text-brand-blue font-semibold text-sm hover:text-brand-blue-dark transition-colors">
                    Read More
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
