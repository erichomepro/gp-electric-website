---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = 'https://gpelectricinc.com';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Organization",
    "name": "GP Electric Inc",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "GP Electric Inc",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/images/og-default.jpg`
    }
  },
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteUrl}/blog/${post.id}`
  },
  "keywords": post.data.keywords.join(', ')
};

// Build FAQ schema for posts with FAQ sections
const faqSchemas: Record<string, any[]> = {
  'how-much-does-electrician-cost-grande-prairie': [
    {
      "@type": "Question",
      "name": "Do I need a permit for electrical work in Grande Prairie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, most electrical work requires a permit from Safety Codes. This includes panel upgrades, new circuits, rewiring, and even some fixture installations. Your electrician should handle the permit process for you."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a panel upgrade take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most panel upgrades take 4 to 8 hours. Your power will be off for part of the day, so plan accordingly — especially in winter when you don't want your pipes freezing."
      }
    },
    {
      "@type": "Question",
      "name": "Can I do my own electrical work in Alberta?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Homeowners can do basic work in their own home, but you still need a homeowner permit and an inspection. For anything beyond swapping a light switch, we strongly recommend hiring a licensed electrician."
      }
    },
    {
      "@type": "Question",
      "name": "How much does an electrician cost in Grande Prairie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Common pricing ranges: Panel upgrade $2,500-$5,000, outlet installation $150-$300, whole-home rewiring $8,000-$15,000, EV charger installation $800-$2,000. Prices vary based on home age, access, and materials."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between 100-amp and 200-amp service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "100-amp was standard in older homes but doesn't cut it for modern electrical loads. 200-amp service gives you the capacity to run air conditioning, EV chargers, hot tubs, and home offices without overloading your system."
      }
    }
  ],
  'spring-electrical-safety-checklist-grande-prairie': [
    {
      "@type": "Question",
      "name": "How often should I have my home's electrical system inspected?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For homes under 25 years old with no known issues, every 5 to 10 years. For older homes built before 1990, every 3 to 5 years. If you notice warning signs like flickering lights, tripping breakers, or burning smells, call immediately."
      }
    },
    {
      "@type": "Question",
      "name": "Can I do spring electrical maintenance myself?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can safely do visual inspections, test GFCI outlets, replace outdoor outlet covers, change light bulbs, and test smoke detectors. Anything involving opening panels, touching wiring, or adding circuits should be done by a licensed electrician."
      }
    },
    {
      "@type": "Question",
      "name": "What does an electrical safety inspection cost in Grande Prairie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A full electrical safety inspection typically runs $150 to $300 depending on the size of your home. GP Electric offers free assessments for specific concerns — if you've spotted a problem and want us to look at it, the initial visit is on us."
      }
    },
    {
      "@type": "Question",
      "name": "Is rodent damage to wiring covered by home insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on your policy. Some Alberta home insurance policies cover damage caused by vermin; others exclude it. Check with your insurer. The real risk is fire, not the repair bill."
      }
    },
    {
      "@type": "Question",
      "name": "When should I call an electrician versus handling it myself?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If it involves visual inspection only, you can do it. If it involves touching anything that carries electricity, pulling wires, or working inside a panel, call a professional. Electrical accidents send people to the hospital and start house fires."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to upgrade my outdoor outlets to GFCI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If your outdoor outlets aren't GFCI-protected, they don't meet current code. Upgrading is a smart safety decision, especially if you have kids, a hot tub, or use outdoor outlets frequently. A GFCI outlet replacement typically costs $150 to $250 installed."
      }
    }
  ]
};

const faqEntries = faqSchemas[post.id];
const faqSchema = faqEntries ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqEntries
} : null;

const schemas = [articleSchema, faqSchema].filter(Boolean);
---

<BaseLayout title={post.data.title} description={post.data.description} schema={articleSchema}>
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <section class="relative overflow-hidden py-16 sm:py-24" style="background: #0a0f1a;">
    <div class="absolute inset-0">
      <img src="/images/tools-bg.jpg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,15,26,0.80) 0%, rgba(13,21,38,0.75) 100%);"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a href="/blog" class="inline-flex items-center gap-2 text-brand-blue hover:text-brand-blue-light text-sm font-medium transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Back to Blog
        </a>
      </div>
      <p class="text-brand-blue font-semibold text-sm uppercase tracking-wider mb-3">{formattedDate}</p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-white leading-tight mb-4">
        {post.data.title}
      </h1>
      <p class="text-lg text-brand-gray-300 leading-relaxed">
        {post.data.description}
      </p>
      <p class="text-sm text-brand-gray-500 mt-4">By {post.data.author}</p>
    </div>
  </section>

  <article class="py-12 sm:py-16 bg-brand-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-lg prose-gray max-w-none
      prose-headings:font-bold prose-headings:text-brand-gray-900
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-brand-gray-700 prose-p:leading-relaxed
      prose-strong:text-brand-gray-900
      prose-li:text-brand-gray-700
      prose-a:text-brand-blue prose-a:font-semibold hover:prose-a:text-brand-blue-dark">
      <Content />
    </div>
  </article>

  <CTASection
    headline="Have an Electrical Question?"
    subtext="Whether you need a quote, want to understand the code, or just have a quick question — we're always happy to help. Give us a call or send us a message."
  />
</BaseLayout>
