---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = "Get a free quote from GP Electric Inc in Grande Prairie. Contact us for residential, commercial, industrial, or farm electrical services. Call 780-882-3046 or fill out our form.";
---

<BaseLayout title="Contact / Get a Free Quote" description={description}>
  <section class="relative overflow-hidden py-16 sm:py-24" style="background: #0a0f1a;">
    <div class="absolute inset-0">
      <img src="/images/hero-panel.jpg" alt="Contact GP Electric Inc for electrical services in Grande Prairie" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,15,26,0.80) 0%, rgba(13,21,38,0.75) 100%);"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-white leading-tight mb-6">
          Get a Free Quote
        </h1>
        <p class="text-lg text-brand-gray-300 leading-relaxed">
          Tell us about your project and we'll get back to you fast — usually within a few hours. Free estimates, no obligation.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Form -->
        <div class="lg:col-span-2">
          <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-semibold text-brand-gray-700 mb-2">Your Name *</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-brand-gray-300 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-colors" placeholder="John Smith" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold text-brand-gray-700 mb-2">Phone Number *</label>
                <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 rounded-lg border border-brand-gray-300 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-colors" placeholder="780-XXX-XXXX" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-brand-gray-700 mb-2">Email Address</label>
              <input type="email" id="email" name="email" class="w-full px-4 py-3 rounded-lg border border-brand-gray-300 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-colors" placeholder="john@example.com" />
            </div>

            <div>
              <label for="service" class="block text-sm font-semibold text-brand-gray-700 mb-2">Service Needed *</label>
              <select id="service" name="service" required class="w-full px-4 py-3 rounded-lg border border-brand-gray-300 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-colors bg-brand-white">
                <option value="">Select a service...</option>
                <option value="residential">Residential Electrical</option>
                <option value="commercial">Commercial Electrical</option>
                <option value="industrial">Industrial Electrical</option>
                <option value="farm">Farm & Acreage Electrical</option>
                <option value="emergency">Emergency Electrical</option>
                <option value="panel">Panel Upgrade</option>
                <option value="ev-charger">EV Charger Installation</option>
                <option value="generator">Generator Installation</option>
                <option value="pumps">Pumps & Pressure Equipment</option>
                <option value="other">Other / Not Sure</option>
              </select>
            </div>

            <div>
              <label for="location" class="block text-sm font-semibold text-brand-gray-700 mb-2">Your Location</label>
              <select id="location" name="location" class="w-full px-4 py-3 rounded-lg border border-brand-gray-300 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-colors bg-brand-white">
                <option value="">Select your area...</option>
                <option value="grande-prairie">Grande Prairie</option>
                <option value="clairmont">Clairmont</option>
                <option value="sexsmith">Sexsmith</option>
                <option value="beaverlodge">Beaverlodge</option>
                <option value="wembley">Wembley</option>
                <option value="hythe">Hythe</option>
                <option value="spirit-river">Spirit River</option>
                <option value="valleyview">Valleyview</option>
                <option value="fairview">Fairview</option>
                <option value="peace-river">Peace River</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-brand-gray-700 mb-2">Tell Us About Your Project *</label>
              <textarea id="message" name="message" required rows="5" class="w-full px-4 py-3 rounded-lg border border-brand-gray-300 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 outline-none transition-colors resize-y" placeholder="Describe your project, what you need done, and any relevant details..."></textarea>
            </div>

            <button type="submit" class="w-full sm:w-auto bg-brand-blue hover:bg-brand-blue-dark text-brand-white px-8 py-4 rounded-lg font-bold text-lg transition-colors shadow-sm">
              Send Quote Request
            </button>

            <p class="text-xs text-brand-gray-500">We typically respond within a few hours during business hours. For emergencies, call us directly at 780-882-3046.</p>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="space-y-6">
          <div class="bg-brand-gray-50 rounded-2xl p-6 border border-brand-gray-200">
            <h3 class="font-bold text-brand-gray-900 text-lg mb-4">Contact Information</h3>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-brand-blue shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <div>
                  <p class="font-semibold text-brand-gray-900">Phone</p>
                  <a href="tel:7808823046" class="text-brand-blue hover:text-brand-blue-dark font-bold">780-882-3046</a>
                  <p class="text-xs text-brand-gray-500 mt-1">Available 24/7 for emergencies</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-brand-blue shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <div>
                  <p class="font-semibold text-brand-gray-900">Email</p>
                  <a href="mailto:gpelectric@outlook.com" class="text-brand-blue hover:text-brand-blue-dark">gpelectric@outlook.com</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-brand-blue shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <div>
                  <p class="font-semibold text-brand-gray-900">Service Area</p>
                  <p class="text-sm text-brand-gray-600">Grande Prairie & the Peace Country region</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-brand-blue shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                <div>
                  <p class="font-semibold text-brand-gray-900">Facebook</p>
                  <a href="https://facebook.com/gpelectricinc" target="_blank" rel="noopener noreferrer" class="text-brand-blue hover:text-brand-blue-dark text-sm">@gpelectricinc</a>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-brand-blue rounded-2xl p-6 text-brand-white">
            <h3 class="font-bold text-lg mb-2">Electrical Emergency?</h3>
            <p class="text-blue-100 text-sm mb-4">Don't fill out a form — call us directly. We're available 24/7 for electrical emergencies.</p>
            <a href="tel:7808823046" class="flex items-center justify-center gap-2 bg-brand-white text-brand-blue px-5 py-3 rounded-lg font-bold hover:bg-blue-50 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call Now: 780-882-3046
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
