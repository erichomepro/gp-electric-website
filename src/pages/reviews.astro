---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

const description = "Read reviews and testimonials from GP Electric Inc customers in Grande Prairie. See why the Peace Country trusts us with their electrical needs.";
---

<BaseLayout title="Reviews & Testimonials" description={description}>
  <section class="relative overflow-hidden py-16 sm:py-24" style="background: #0a0f1a;">
    <div class="absolute inset-0">
      <img src="/images/home-exterior.jpg" alt="Grande Prairie home serviced by GP Electric Inc" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,15,26,0.80) 0%, rgba(13,21,38,0.75) 100%);"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-brand-blue font-semibold text-sm uppercase tracking-wider mb-3">Customer Reviews</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-white leading-tight mb-6">
          What Our Customers Say
        </h1>
        <p class="text-lg text-brand-gray-300 leading-relaxed">
          Don't just take our word for it. Here's what Grande Prairie and Peace Country customers have to say about working with GP Electric.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Placeholder for when reviews come in -->
      <div class="text-center py-12">
        <div class="w-20 h-20 bg-brand-blue/10 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
        </div>
        <h2 class="text-2xl font-bold text-brand-gray-900 mb-4">We're Building Our Review Collection</h2>
        <p class="text-brand-gray-600 mb-8 max-w-lg mx-auto">
          We're just getting started with our online presence, but we've been delivering quality electrical work across Grande Prairie for years. Reviews from our happy customers are on the way.
        </p>
        <div class="bg-brand-gray-50 rounded-2xl p-8 border border-brand-gray-200 max-w-lg mx-auto">
          <h3 class="font-bold text-brand-gray-900 mb-2">Had Work Done By GP Electric?</h3>
          <p class="text-sm text-brand-gray-600 mb-4">We'd love to hear about your experience. Your review helps other people in Grande Prairie find a trusted electrician.</p>
          <a href="https://g.page/review" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-brand-blue hover:bg-brand-blue-dark text-brand-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-colors">
            Leave Us a Google Review
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
