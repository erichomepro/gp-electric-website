---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

const description = "GP Electric Inc. Grande Prairie's trusted electrician. Learn about our team, our commitment to quality, and why the Peace Country trusts us with their electrical needs.";
---

<BaseLayout title="About Us" description={description}>
  <section class="relative overflow-hidden py-16 sm:py-24" style="background: #0a0f1a;">
    <div class="absolute inset-0">
      <img src="/images/tools-bg.jpg" alt="Electrical tools and equipment used by GP Electric Inc" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,15,26,0.80) 0%, rgba(13,21,38,0.75) 100%);"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-brand-blue font-semibold text-sm uppercase tracking-wider mb-3">About GP Electric Inc</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-white leading-tight mb-6">
          Connections That Last
        </h1>
        <p class="text-lg text-brand-gray-300 leading-relaxed">
          GP Electric Inc is a licensed electrical contractor based in Grande Prairie, Alberta. We serve homeowners, businesses, farms, and industrial clients across the Peace Country with quality electrical work you can count on.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-gray-900 mb-6">
            Who We Are
          </h2>
          <p class="text-brand-gray-600 mb-4 leading-relaxed">
            GP Electric Inc is a full-service electrical contractor based right here in Grande Prairie, Alberta. We specialize in residential, commercial, industrial, and farm electrical services. Serving the city and communities across the entire Peace Country region.
          </p>
          <p class="text-brand-gray-600 mb-4 leading-relaxed">
            "Connections that last" isn't just our tagline. It's how we run every job. When we make an electrical connection, it's tight and it lasts forever, just like our relationships with our customers.
          </p>
          <p class="text-brand-gray-600 mb-8 leading-relaxed">
            We live here, we work here, and we're invested in this community. When you call GP Electric, you're getting a local team that takes pride in their work and stands behind every job.
          </p>

          <h3 class="text-xl font-bold text-brand-gray-900 mb-4">What We Do</h3>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              "Residential Electrical",
              "Commercial Electrical",
              "Industrial Electrical",
              "Farm & Acreage",
              "24/7 Emergency Service",
              "Panel Upgrades",
              "EV Charger Installation",
              "Generator Installation",
              "Pumps & Pressure",
              "Lighting Installation"
            ].map((service) => (
              <div class="flex items-center gap-2 text-sm text-brand-gray-700">
                <svg class="w-4 h-4 text-brand-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {service}
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-brand-gray-50 rounded-2xl p-8 border border-brand-gray-200">
            <h3 class="text-xl font-bold text-brand-gray-900 mb-6">Why Choose GP Electric</h3>
            <div class="space-y-5">
              <div>
                <h4 class="font-bold text-brand-gray-900 mb-1">Licensed & Insured</h4>
                <p class="text-sm text-brand-gray-600">Fully licensed electrical contractor. All work meets the 2024 Canadian Electrical Code. Fully insured for your protection.</p>
              </div>
              <div>
                <h4 class="font-bold text-brand-gray-900 mb-1">24/7 Emergency Service</h4>
                <p class="text-sm text-brand-gray-600">Electrical emergencies don't wait for business hours. Neither do we. Call anytime. Day, night, weekends, holidays.</p>
              </div>
              <div>
                <h4 class="font-bold text-brand-gray-900 mb-1">Complete Service Range</h4>
                <p class="text-sm text-brand-gray-600">From changing an outlet to wiring a complete industrial facility, we have the skills and experience for any electrical project.</p>
              </div>
              <div>
                <h4 class="font-bold text-brand-gray-900 mb-1">Local & Accountable</h4>
                <p class="text-sm text-brand-gray-600">We're your neighbors. Our reputation matters to us. We stand behind every job because we'll see you at the grocery store.</p>
              </div>
              <div>
                <h4 class="font-bold text-brand-gray-900 mb-1">Free Estimates</h4>
                <p class="text-sm text-brand-gray-600">Every project starts with a free, no-obligation quote. We'll assess the work, explain what's needed, and give you a clear price.</p>
              </div>
            </div>
          </div>

          <div class="bg-brand-blue rounded-2xl p-8 text-brand-white">
            <h3 class="text-xl font-bold mb-3">Our Service Area</h3>
            <p class="text-blue-100 text-sm mb-4">
              Based in Grande Prairie, we serve the entire Peace Country region including Clairmont, Sexsmith, Beaverlodge, Wembley, Hythe, Spirit River, Valleyview, Fairview, and Peace River.
            </p>
            <a href="/areas/" class="inline-flex items-center gap-2 bg-brand-white text-brand-blue px-5 py-2.5 rounded-lg font-bold text-sm hover:bg-blue-50 transition-colors">
              View All Service Areas
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
