---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const services = [
  { name: "Standby Generator Installation", description: "Whole-home or whole-business standby generators that start automatically when the power goes out." },
  { name: "Automatic Transfer Switch", description: "Seamless power transfer from grid to generator. Your lights stay on without lifting a finger." },
  { name: "Portable Generator Hookup", description: "Manual transfer switch installation so you can safely connect a portable generator to your home's electrical system." },
  { name: "Farm & Acreage Generators", description: "Keep your water pumps, heating, and essential farm systems running during extended power outages." },
  { name: "Commercial Backup Power", description: "Standby generators for businesses, medical offices, and facilities that can't afford downtime." },
  { name: "Generator Maintenance", description: "Annual maintenance to ensure your generator starts when you need it most." },
];

const faqs = [
  { question: "How much does a standby generator cost?", answer: "A whole-home standby generator with automatic transfer switch typically costs $8,000-$20,000+ installed, depending on the size and brand. Portable generator hookups with manual transfer switches run $1,500-$3,000. We provide free quotes for your specific situation." },
  { question: "What size generator do I need?", answer: "It depends on what you want to power. A 10kW generator handles essentials (furnace, fridge, lights, well pump). A 20-22kW unit powers most of a typical home. For farms with shops and outbuildings, you may need 30kW+. We'll calculate your load and recommend the right size." },
  { question: "Why do I need a transfer switch?", answer: "A transfer switch prevents backfeed — where generator power flows back into utility lines, creating a lethal hazard for power line workers. It's required by code and essential for safety. Never connect a generator without one." },
  { question: "How often does the generator need maintenance?", answer: "Most standby generators should be serviced annually — oil change, filter replacement, battery check, and load test. We offer maintenance plans to keep your generator ready when you need it." },
];

const relatedServices = [
  { name: "Panel Upgrades", href: "/services/panel-upgrades" },
  { name: "Farm & Acreage", href: "/services/farm-acreage" },
  { name: "24/7 Emergency", href: "/services/emergency" },
];
---

<ServiceLayout
  title="Generator Installation in Grande Prairie"
  description="Generator installation in Grande Prairie. Standby generators, transfer switches, portable hookups for homes, farms & businesses. GP Electric — 780-882-3046."
  headline="Backup Power for Alberta Winters. Peace of Mind Year-Round."
  subheadline="Generator Installation"
  heroDescription="When temperatures hit -40C and the power goes out, your family's safety depends on backup power. GP Electric installs standby generators and transfer switches for homes, farms, and businesses across Grande Prairie and the Peace Country."
  services={services}
  faqs={faqs}
  relatedServices={relatedServices}
/>
