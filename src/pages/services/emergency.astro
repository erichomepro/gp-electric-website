---
import ServiceLayout from '././layouts/ServiceLayout.astro';

const services = [
  { name: "Power Outages", description: "Lost power to part or all of your home or business? We diagnose and fix the issue fast." },
  { name: "Sparking Panels or Outlets", description: "Sparks from your electrical panel or outlets are a fire hazard. Don't wait. Call immediately." },
  { name: "Breaker Won't Reset", description: "A breaker that refuses to reset could indicate a serious fault. We'll find the cause and fix it safely." },
  { name: "Burning Smell from Electrical", description: "If you smell burning near outlets, switches, or your panel, turn off the breaker and call us immediately." },
  { name: "Exposed or Damaged Wiring", description: "Storm damage, renovation accidents, or rodent damage. Exposed wires are dangerous. We'll make it safe." },
  { name: "Furnace or Heating Circuit Failures", description: "At -40C, a dead furnace circuit is life-threatening. We respond fast to restore your heating." },
  { name: "Water & Electrical Contact", description: "Flooding or water near electrical systems? We'll make it safe and restore power properly." },
  { name: "Generator Hookup & Transfer", description: "Need emergency generator power? We can set up a safe temporary connection to keep essential systems running." },
];

const faqs = [
  { question: "How fast can you respond to an emergency?", answer: "We aim to be on-site within 60 minutes for emergency calls in the Grande Prairie area. For surrounding communities, response times vary based on distance but we prioritize emergencies above all other work." },
  { question: "Do you charge extra for emergency calls?", answer: "Emergency calls outside of regular business hours may include an after-hours service fee. We'll always tell you upfront before any work begins. No surprises." },
  { question: "What should I do while waiting for an electrician?", answer: "If it's safe to do so: turn off the breaker that's causing the issue. If you see sparks, smell burning, or see smoke, turn off the main breaker and get your family out of the house. Call 911 if there's any immediate danger, then call us." },
  { question: "Do you handle emergencies for businesses too?", answer: "Yes. We provide 24/7 emergency electrical service for homes, businesses, farms, and industrial facilities throughout the Grande Prairie region." },
];

const relatedServices = [
  { name: "Residential Electrical", href: "/services/residential/" },
  { name: "Commercial Electrical", href: "/services/commercial/" },
  { name: "Generator Installation", href: "/services/generator/" },
  { name: "Panel Upgrades", href: "/services/panel-upgrades/" },
];
---

<ServiceLayout
  title="24/7 Emergency Electrician in Grande Prairie"
  description="24/7 emergency electrician in Grande Prairie. Power outages, sparking panels, breaker failures, furnace circuits. Fast response. Call GP Electric NOW: 780-882-3046."
  headline="Electrical Emergency? We're On Our Way."
  subheadline="24/7 Emergency Electrical Service"
  heroDescription="Power out? Panel sparking? Furnace dead at -40C? GP Electric responds fast. Day or night, weekends and holidays. When every minute counts, we're the electrician Grande Prairie calls."
  services={services}
  faqs={faqs}
  relatedServices={relatedServices}
>
  <section slot="content" class="py-16 bg-brand-red/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <div class="w-20 h-20 bg-brand-red/10 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-gray-900 mb-4">
          Don't Wait. Electrical Emergencies Get Worse.
        </h2>
        <p class="text-lg text-brand-gray-600 mb-8">
          A sparking panel doesn't fix itself. A dead furnace circuit at -40C puts your family at risk. Every minute matters. Call GP Electric now. We answer the phone 24 hours a day, 7 days a week, 365 days a year.
        </p>
        <a href="tel:7808823046" class="inline-flex items-center justify-center gap-3 bg-brand-red hover:bg-red-700 text-brand-white px-10 py-5 rounded-xl font-black text-2xl transition-colors shadow-lg">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          780-882-3046
        </a>
        <p class="text-sm text-brand-gray-500 mt-4">Available 24/7. Grande Prairie & surrounding communities</p>
      </div>
    </div>
  </section>
</ServiceLayout>
