---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';

const description = "GP Electric Inc offers complete electrical services in Grande Prairie — residential, commercial, industrial, farm & acreage, 24/7 emergency. Licensed, insured, trusted.";
---

<BaseLayout title="Electrical Services" description={description}>
  <section class="relative overflow-hidden py-16 sm:py-24" style="background: #0a0f1a;">
    <div class="absolute inset-0">
      <img src="/images/electrician-work.jpg" alt="Full range of electrical services offered by GP Electric Inc" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="eager" />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,15,26,0.80) 0%, rgba(13,21,38,0.75) 100%);"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-brand-blue font-semibold text-sm uppercase tracking-wider mb-3">GP Electric Inc</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-white leading-tight mb-6">
          Complete Electrical Services for Grande Prairie & the Peace Country
        </h1>
        <p class="text-lg text-brand-gray-300 leading-relaxed">
          From your home to your farm to your business — GP Electric handles it all. Licensed, insured, and available 24/7 for emergencies.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <ServiceCard title="Residential Electrical" description="Panel upgrades, rewiring, lighting, outlets, hot tub wiring, smart home installations, and complete home electrical." href="/services/residential" icon="home" />
        <ServiceCard title="Commercial Electrical" description="Tenant improvements, lighting retrofits, power distribution, new construction for businesses of all sizes." href="/services/commercial" icon="building" />
        <ServiceCard title="Industrial Electrical" description="Oil & gas, instrumentation, motor controls, power distribution, plant maintenance, and heavy industrial." href="/services/industrial" icon="industry" />
        <ServiceCard title="Farm & Acreage" description="Shop wiring, barn electrical, grain bin circuits, yard lighting, underground service, and complete farm electrical." href="/services/farm-acreage" icon="farm" />
        <ServiceCard title="24/7 Emergency" description="Power out? Panel sparking? We respond fast — day or night, weekends and holidays." href="/services/emergency" icon="emergency" />
        <ServiceCard title="Pumps & Pressure" description="Pressure washers, pump installations, air conditioner electrical, and specialized equipment hookups." href="/services/pumps-pressure" icon="pump" />
      </div>

      <h2 class="text-2xl font-extrabold text-brand-gray-900 mt-16 mb-8">Specialty Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <a href="/services/panel-upgrades" class="group flex items-center gap-4 p-6 rounded-xl border border-brand-gray-200 hover:border-brand-blue hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-brand-blue/10 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-brand-gray-900 group-hover:text-brand-blue">Panel Upgrades</h3>
            <p class="text-sm text-brand-gray-500">100A to 200A and beyond</p>
          </div>
        </a>
        <a href="/services/ev-charger" class="group flex items-center gap-4 p-6 rounded-xl border border-brand-gray-200 hover:border-brand-blue hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-brand-blue/10 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-brand-gray-900 group-hover:text-brand-blue">EV Charger Installation</h3>
            <p class="text-sm text-brand-gray-500">Home & commercial — rebates available</p>
          </div>
        </a>
        <a href="/services/generator" class="group flex items-center gap-4 p-6 rounded-xl border border-brand-gray-200 hover:border-brand-blue hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-brand-blue/10 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-brand-gray-900 group-hover:text-brand-blue">Generator Installation</h3>
            <p class="text-sm text-brand-gray-500">Backup power for Alberta winters</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
