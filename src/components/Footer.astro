---
const currentYear = new Date().getFullYear();
---
<footer class="bg-brand-gray-900 text-brand-gray-300">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Company Info -->
      <div>
        <div class="mb-4">
          <span class="text-2xl font-black text-brand-white tracking-tight">GP</span>
          <span class="text-2xl font-bold text-brand-blue tracking-tight">Electric</span>
          <span class="text-sm font-semibold text-brand-gray-500 ml-1">Inc.</span>
        </div>
        <p class="text-sm text-brand-gray-400 mb-4 italic">"Connections That Last"</p>
        <p class="text-sm text-brand-gray-400 mb-6">Licensed electrician serving Grande Prairie and the Peace Country region. Residential, commercial, industrial, and farm electrical.</p>
        <div class="space-y-2">
          <a href="tel:7808823046" class="flex items-center gap-2 text-brand-white hover:text-brand-blue transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span class="font-semibold">780-882-3046</span>
          </a>
          <a href="mailto:gpelectric@outlook.com" class="flex items-center gap-2 text-brand-gray-400 hover:text-brand-blue transition-colors text-sm">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            gpelectric@outlook.com
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-brand-white font-bold text-lg mb-4">Services</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/services/residential/" class="hover:text-brand-blue transition-colors">Residential Electrical</a></li>
          <li><a href="/services/commercial/" class="hover:text-brand-blue transition-colors">Commercial Electrical</a></li>
          <li><a href="/services/industrial/" class="hover:text-brand-blue transition-colors">Industrial Electrical</a></li>
          <li><a href="/services/farm-acreage/" class="hover:text-brand-blue transition-colors">Farm & Acreage</a></li>
          <li><a href="/services/emergency/" class="hover:text-brand-blue transition-colors">24/7 Emergency</a></li>
          <li><a href="/services/panel-upgrades/" class="hover:text-brand-blue transition-colors">Panel Upgrades</a></li>
          <li><a href="/services/ev-charger/" class="hover:text-brand-blue transition-colors">EV Charger Installation</a></li>
          <li><a href="/services/generator/" class="hover:text-brand-blue transition-colors">Generator Installation</a></li>
        </ul>
      </div>

      <!-- Service Areas -->
      <div>
        <h3 class="text-brand-white font-bold text-lg mb-4">Service Areas</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/areas/grande-prairie/" class="hover:text-brand-blue transition-colors">Grande Prairie</a></li>
          <li><a href="/areas/clairmont/" class="hover:text-brand-blue transition-colors">Clairmont</a></li>
          <li><a href="/areas/sexsmith/" class="hover:text-brand-blue transition-colors">Sexsmith</a></li>
          <li><a href="/areas/beaverlodge/" class="hover:text-brand-blue transition-colors">Beaverlodge</a></li>
          <li><a href="/areas/wembley/" class="hover:text-brand-blue transition-colors">Wembley</a></li>
          <li><a href="/areas/hythe/" class="hover:text-brand-blue transition-colors">Hythe</a></li>
          <li><a href="/areas/spirit-river/" class="hover:text-brand-blue transition-colors">Spirit River</a></li>
          <li><a href="/areas/valleyview/" class="hover:text-brand-blue transition-colors">Valleyview</a></li>
          <li><a href="/areas/fairview/" class="hover:text-brand-blue transition-colors">Fairview</a></li>
          <li><a href="/areas/peace-river/" class="hover:text-brand-blue transition-colors">Peace River</a></li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-brand-white font-bold text-lg mb-4">Company</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about/" class="hover:text-brand-blue transition-colors">About Us</a></li>
          <li><a href="/reviews/" class="hover:text-brand-blue transition-colors">Reviews</a></li>
          <li><a href="/blog/" class="hover:text-brand-blue transition-colors">Blog</a></li>
          <li><a href="/contact/" class="hover:text-brand-blue transition-colors">Contact / Get a Quote</a></li>
        </ul>
        <div class="mt-6">
          <h4 class="text-brand-white font-semibold text-sm mb-3">Follow Us</h4>
          <a href="https://facebook.com/gpelectricinc" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm hover:text-brand-blue transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Facebook
          </a>
        </div>
        <div class="mt-6 p-4 bg-brand-gray-800 rounded-lg">
          <p class="text-xs text-brand-gray-400 mb-1">Licensed & Insured</p>
          <p class="text-xs text-brand-gray-500">Serving Grande Prairie & the Peace Country region</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-brand-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-brand-gray-500">&copy; {currentYear} GP Electric Inc. All rights reserved.</p>
      <p class="text-xs text-brand-gray-600">Grande Prairie, Alberta</p>
      <p class="text-xs text-brand-gray-600">
        Website by
        <a href="https://aiprecisionmarketing.ca/portfolio" target="_blank" rel="noopener noreferrer" class="hover:text-brand-blue transition-colors">
          AI Precision Marketing
        </a>
      </p>
    </div>
  </div>
</footer>
