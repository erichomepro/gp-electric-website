---
interface Props {
  headline?: string;
  subtext?: string;
}

const {
  headline = "Ready to Get Started?",
  subtext = "Whether it's a quick repair or a full shop build, we're here to help. Get a free quote today — no pressure, no obligation."
} = Astro.props;
---

<section class="py-20 bg-gradient-to-br from-brand-gray-900 via-brand-gray-800 to-brand-black relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-1/2 left-1/2 w-96 h-96 bg-brand-blue rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-white mb-4">
      {headline}
    </h2>
    <p class="text-lg text-brand-gray-300 mb-10 max-w-2xl mx-auto">
      {subtext}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
      <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-brand-blue hover:bg-brand-blue-dark text-brand-white px-8 py-4 rounded-lg font-bold text-lg transition-colors shadow-lg shadow-brand-blue/25">
        Get a Free Quote
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <a href="tel:7808823046" class="inline-flex items-center justify-center gap-2 border-2 border-brand-gray-600 hover:border-brand-blue text-brand-white px-8 py-4 rounded-lg font-bold text-lg transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        780-882-3046
      </a>
    </div>

    <p class="text-sm text-brand-gray-500">
      Serving Grande Prairie, Clairmont, Sexsmith, Beaverlodge, Wembley, and the entire Peace Country region.
    </p>
  </div>
</section>
