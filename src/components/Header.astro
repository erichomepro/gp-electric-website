---
// Sticky header with phone + CTA
---
<header class="sticky top-0 z-50 bg-brand-white shadow-md border-b border-brand-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <div class="flex items-center">
          <span class="text-2xl lg:text-3xl font-black text-brand-black tracking-tight">GP</span>
          <span class="text-2xl lg:text-3xl font-bold text-brand-blue tracking-tight">Electric</span>
          <span class="text-base lg:text-lg font-semibold text-brand-gray-500 tracking-tight ml-1 self-end mb-0.5">Inc.</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        <div class="relative group">
          <a href="/services/" class="px-3 py-2 text-sm font-medium text-brand-gray-700 hover:text-brand-blue transition-colors">
            Services
            <svg class="inline w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute left-0 top-full pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-brand-white rounded-lg shadow-xl border border-brand-gray-200 py-2">
              <a href="/services/residential/" class="block px-4 py-2 text-sm text-brand-gray-700 hover:bg-brand-gray-50 hover:text-brand-blue">Residential Electrical</a>
              <a href="/services/commercial/" class="block px-4 py-2 text-sm text-brand-gray-700 hover:bg-brand-gray-50 hover:text-brand-blue">Commercial Electrical</a>
              <a href="/services/industrial/" class="block px-4 py-2 text-sm text-brand-gray-700 hover:bg-brand-gray-50 hover:text-brand-blue">Industrial Electrical</a>
              <a href="/services/farm-acreage/" class="block px-4 py-2 text-sm text-brand-gray-700 hover:bg-brand-gray-50 hover:text-brand-blue">Farm & Acreage</a>
              <a href="/services/emergency/" class="block px-4 py-2 text-sm text-brand-gray-700 hover:bg-brand-gray-50 hover:text-brand-blue">24/7 Emergency</a>
              <div class="border-t border-brand-gray-100 my-1"></div>
              <a href="/services/panel-upgrades/" class="block px-4 py-2 text-sm text-brand-gray-700 hover:bg-brand-gray-50 hover:text-brand-blue">Panel Upgrades</a>
              <a href="/services/ev-charger/" class="block px-4 py-2 text-sm text-brand-gray-700 hover:bg-brand-gray-50 hover:text-brand-blue">EV Charger Installation</a>
              <a href="/services/generator/" class="block px-4 py-2 text-sm text-brand-gray-700 hover:bg-brand-gray-50 hover:text-brand-blue">Generator Installation</a>
            </div>
          </div>
        </div>
        <a href="/areas/" class="px-3 py-2 text-sm font-medium text-brand-gray-700 hover:text-brand-blue transition-colors">Service Areas</a>
        <a href="/about/" class="px-3 py-2 text-sm font-medium text-brand-gray-700 hover:text-brand-blue transition-colors">About</a>
        <a href="/reviews/" class="px-3 py-2 text-sm font-medium text-brand-gray-700 hover:text-brand-blue transition-colors">Reviews</a>
        <a href="/blog/" class="px-3 py-2 text-sm font-medium text-brand-gray-700 hover:text-brand-blue transition-colors">Blog</a>
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a href="tel:7808823046" class="flex items-center gap-2 text-brand-blue font-bold text-lg hover:text-brand-blue-dark transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          780-882-3046
        </a>
        <a href="/contact/" class="bg-brand-blue hover:bg-brand-blue-dark text-brand-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-colors shadow-sm">
          Get a Free Quote
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-brand-gray-700 hover:text-brand-blue" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-brand-gray-200 bg-brand-white">
    <div class="px-4 py-4 space-y-1">
      <a href="/services/residential/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">Residential</a>
      <a href="/services/commercial/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">Commercial</a>
      <a href="/services/industrial/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">Industrial</a>
      <a href="/services/farm-acreage/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">Farm & Acreage</a>
      <a href="/services/emergency/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">24/7 Emergency</a>
      <a href="/services/panel-upgrades/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">Panel Upgrades</a>
      <a href="/services/ev-charger/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">EV Chargers</a>
      <a href="/services/generator/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">Generators</a>
      <div class="border-t border-brand-gray-200 my-2"></div>
      <a href="/areas/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">Service Areas</a>
      <a href="/about/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">About</a>
      <a href="/reviews/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">Reviews</a>
      <a href="/blog/" class="block px-3 py-2 text-base font-medium text-brand-gray-700 hover:text-brand-blue hover:bg-brand-gray-50 rounded-md">Blog</a>
      <div class="border-t border-brand-gray-200 my-2"></div>
      <a href="tel:7808823046" class="block px-3 py-3 text-center text-lg font-bold text-brand-blue">
        Call: 780-882-3046
      </a>
      <a href="/contact/" class="block px-3 py-3 text-center bg-brand-blue text-brand-white rounded-lg font-semibold">
        Get a Free Quote
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
